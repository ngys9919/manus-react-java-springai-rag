# ---------------------------------------------------------------------------
# HeiFinance Knowledge Assistant — environment template
# Copy to .env and fill in real values. Never commit the populated file.
# ---------------------------------------------------------------------------

# Chat model credentials (required)
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_MAX_COMPLETION_TOKENS=2048

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/heifinance_rag
DB_USERNAME=heifinance
DB_PASSWORD=heifinance

# Knowledge base and retrieval tuning
KNOWLEDGE_BASE_PATH=../knowledge-base
INGEST_ON_STARTUP=true
CHUNK_SIZE=200
MIN_CHUNK_SIZE_CHARS=80
RETRIEVAL_TOP_K=12
RETRIEVAL_SIMILARITY_THRESHOLD=0.25
RETRIEVAL_MAX_CONTEXT_CHUNKS=12
RETRIEVAL_MAX_PER_DOCUMENT=6
OPENAI_REASONING_EFFORT=low
HEIFINANCE_ALLOWED_ORIGIN_PATTERNS=*

# Backend port
SERVER_PORT=8080
